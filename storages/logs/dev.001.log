{"level":"INFO","time":"2026-01-27T16:21:22.337+0700","caller":"service/mail.service.impl.go:141","msg":"Mark job as processing templateHTML","templateHTML":"<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\n  \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\">\n<head>\n  <meta name=\"color-scheme\" content=\"only light\">\n  <meta name=\"supported-color-schemes\" content=\"light\">\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"x-apple-disable-message-reformatting\" />\n  <title>Yaah Connect x {{.Name}}</title>\n\n  <style type=\"text/css\">\n    body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\n    table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; }\n    img { border:0; height:auto; line-height:100%; outline:none; text-decoration:none; }\n    table { border-collapse:collapse !important; }\n\n    body {\n      margin:0 !important;\n      padding:0 !important;\n      width:100% !important;\n      height:100% !important;\n      background:#050505;\n      color:#ffffff;\n      font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    }\n\n    .neon-text { color:#ccff00; }\n    .tension-border { border-left:2px solid #ccff00; }\n\n    @media screen and (max-width:600px){\n      .mobile-padding { padding:20px !important; }\n      .stack { display:block !important; width:100% !important; }\n      .hero-text { font-size:32px !important; line-height:36px !important; }\n    }\n  </style>\n</head>\n\n<body>\n\n<!-- PREHEADER -->\n<div style=\"display:none;max-height:0;overflow:hidden;\">\n  Connecting {{.Name}} to a new generation of active players.\n</div>\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"#050505\" style=\"background:#050505;\">\n  <tr>\n    <td align=\"center\" bgcolor=\"#050505\" style=\"background:#050505;padding:40px 0;\">\n\n      <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"#050505\"\n        style=\"background:#050505;max-width:600px;\" class=\"mobile-padding\">\n\n        <!-- HEADER -->\n        <tr>\n          <td style=\"padding-bottom:40px;border-bottom:1px solid #1a1a1a;\">\n            <table width=\"100%\">\n              <tr>\n                <td>\n                  <span style=\"font-weight:800;font-size:20px;letter-spacing:-1px;\">\n                    Yaah<span class=\"neon-text\"> Connect</span>\n                  </span>\n                </td>\n                <td align=\"right\" style=\"font-size:12px;color:#666;\">\n                  B2B // PARTNERSHIP\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- HERO -->\n        <tr>\n          <td style=\"padding:60px 0 40px;\">\n            <h1 class=\"hero-text\"\n              style=\"margin:0;font-size:48px;font-weight:800;line-height:52px;letter-spacing:-2px;\">\n              MOMENTUM IS<br/>\n              <span class=\"neon-text\" style=\"background:#111;padding:0 6px;\">\n                BUILT ON COURT.\n              </span>\n            </h1>\n            <p style=\"margin-top:24px;font-size:18px;line-height:28px;color:#aaa;\">\n              Scaling a {{.Category}} venue requires more than equipment.\n            </p>\n          </td>\n        </tr>\n\n        <!-- CORE -->\n        <tr>\n          <td bgcolor=\"#0a0a0a\" style=\"background:#0a0a0a;padding:40px;border:1px solid #1a1a1a;\">\n            <p style=\"margin:0;font-size:16px;line-height:24px;color:#eee;\">\n              <strong>Yaah Connect</strong> is a performance-driven platform designed\n              to eliminate friction between players and venues.\n            </p>\n          </td>\n        </tr>\n\n        <!-- CTA -->\n        <tr>\n          <td align=\"center\" style=\"padding:60px 0;border-top:1px solid #1a1a1a;\">\n            <table cellpadding=\"0\" cellspacing=\"0\">\n              <tr>\n                <td bgcolor=\"#ccff00\" style=\"padding:18px 45px;\">\n                  <a href=\"{{.Url}}\"\n                    style=\"font-size:16px;font-weight:800;color:#000;text-decoration:none;\">\n                    ACTIVATE PARTNERSHIP\n                  </a>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- FOOTER -->\n        <tr>\n          <td style=\"padding-top:40px;border-top:1px solid #1a1a1a;font-size:12px;color:#444;\">\n            &copy; 2024 YAAH CONNECT. ALL RIGHTS RESERVED.\n          </td>\n        </tr>\n\n      </table>\n    </td>\n  </tr>\n</table>\n\n</body>\n</html>\n"}
